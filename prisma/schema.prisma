generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                 String     @id @default(auto()) @map("_id") @db.ObjectId
  name               String?
  email              String?    @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  role               Role       @default(EMPLOYEE)
  accounts           Account[]
  
  employeeManagerId  String?    @db.ObjectId
  managedSchedules   Schedule[] @relation("ManagedSchedules")
  employees          Employee[] @relation("ManagerEmployees")
  Shift              Shift[]
  
  // Optional back-relation for the one-to-one assignment
  employeeAssignment EmployeeUserAssignment?
}

model Account {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.String
  access_token       String?  @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.String
  session_state      String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Employee {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  phone      String?
  position   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  managerId  String   @db.ObjectId
  manager    User     @relation(fields: [managerId], references: [id], name: "ManagerEmployees")
  shifts     ShiftAssignment[]

  // Back-relation for the one-to-one connection via EmployeeUserAssignment
  assignment EmployeeUserAssignment? @relation("EmployeeUser")
}

model Shift {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  startTime   DateTime
  endTime     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  allDay      Boolean  @default(false)
  title       String?
  assignments ShiftAssignment[]
  managerId   String   @db.ObjectId
  manager     User     @relation(fields: [managerId], references: [id])
}

model ShiftAssignment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  shiftId    String   @db.ObjectId
  employeeId String   @db.ObjectId
  createdAt  DateTime @default(now())
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Schedule {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  startDate   DateTime
  endDate     DateTime
  isPublic    Boolean   @default(false)
  managerId   String    @unique @db.ObjectId
  manager     User      @relation(fields: [managerId], references: [id], name: "ManagedSchedules")
}

model EmployeeUserAssignment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  employee   Employee @relation("EmployeeUser", fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.ObjectId

  @@unique([employeeId])
  @@unique([userId])
}

enum Role {
  MANAGER
  EMPLOYEE
}
